//@version=6
indicator("Bookmap Style Heatmap + Volume Bubbles", "BM-HM", overlay=true,
     max_boxes_count=500, max_labels_count=500)

// ============ INPUTS ============
gHM = "Heatmap"
lookback    = input.int(80,  "Lookback Bars",       minval=20, maxval=300, group=gHM)
priceLevels = input.int(40,  "Price Levels (rows)", minval=10, maxval=80,  group=gHM)
showHM      = input.bool(true, "Show Heatmap", group=gHM)

gBB = "Volume Bubbles"
showBub = input.bool(true,  "Show Bubbles", group=gBB)
bubLB   = input.int(100,    "Bubble Volume MA Length", minval=10, maxval=500, group=gBB)
bubMin  = input.float(1.5,  "Min Volume x Avg",        minval=0.1, step=0.1,  group=gBB)
buyCol  = input.color(color.lime, "Buy Bubble",  group=gBB)
sellCol = input.color(color.red,  "Sell Bubble", group=gBB)

// ============ STATE ============
var array<box>   boxes = array.new<box>()
var array<float> grid  = array.new<float>(priceLevels, 0.0)

clearBoxes() =>
    if boxes.size() > 0
        for i = 0 to boxes.size() - 1
            box.delete(boxes.get(i))
        boxes.clear()

// Bookmap-ish gradient: deep blue -> cyan -> green -> yellow -> red
heatColor(float r) =>
    color result = na
    if r < 0.25
        result := color.from_gradient(r, 0.0, 0.25, color.new(color.blue, 92), color.new(color.aqua, 82))
    else if r < 0.50
        result := color.from_gradient(r, 0.25, 0.50, color.new(color.aqua, 82), color.new(color.lime, 72))
    else if r < 0.75
        result := color.from_gradient(r, 0.50, 0.75, color.new(color.lime, 72), color.new(color.yellow, 52))
    else
        result := color.from_gradient(r, 0.75, 1.00, color.new(color.yellow, 52), color.new(color.red, 22))
    result

bubbleSize(float ratio) =>
    string s = size.small
    if ratio > 4
        s := size.huge
    else if ratio > 2.5
        s := size.large
    else if ratio > 1.8
        s := size.normal
    s

// ============ HEATMAP ============
hh  = ta.highest(high, lookback)
ll  = ta.lowest(low,  lookback)
rng = hh - ll

if barstate.islast
    clearBoxes()
    if showHM and rng > 0
        levelH = rng / priceLevels
        for i = 0 to priceLevels - 1
            grid.set(i, 0.0)

        for b = 0 to lookback - 1
            bH = high[b]
            bL = low[b]
            bV = volume[b]
            if bV > 0 and bH > bL
                lIdx = math.max(0,               math.floor((bL - ll) / levelH))
                hIdx = math.min(priceLevels - 1, math.floor((bH - ll) / levelH))
                n    = hIdx - lIdx + 1
                vpl  = bV / n
                for i = lIdx to hIdx
                    grid.set(i, grid.get(i) + vpl)

        maxV = grid.max()
        if maxV > 0
            leftX  = bar_index - lookback + 1
            rightX = bar_index
            for i = 0 to priceLevels - 1
                v = grid.get(i)
                if v > 0
                    yBot = ll + i * levelH
                    yTop = yBot + levelH
                    bx = box.new(leftX, yTop, rightX, yBot, border_color = color.new(color.black, 100), bgcolor = heatColor(v / maxV))
                    boxes.push(bx)

// ============ VOLUME BUBBLES ============
avgVol = ta.sma(volume, bubLB)
ratio  = nz(volume / avgVol, 0)
bigVol = ratio > bubMin
bubCol = close >= open ? buyCol : sellCol
bubY   = (high + low) / 2

if showBub and bigVol
    label.new(bar_index, bubY, "●",
         color     = color.new(color.black, 100),
         textcolor = color.new(bubCol, 15),
         style     = label.style_none,
         size      = bubbleSize(ratio))
